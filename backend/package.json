{
  "name": "budgeting-app-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:app": "esbuild src/handlers/app.ts --bundle --platform=node --target=node20 --outfile=dist/app/app.js --external:pg-native",
    "build:migrate": "esbuild src/db/migrate.ts --bundle --platform=node --target=node20 --outfile=dist/migrate/migrate.js --external:pg-native",
    "build:scheduler": "esbuild src/handlers/scheduler.ts --bundle --platform=node --target=node20 --outfile=dist/scheduler/scheduler.js --external:pg-native",
    "build:ingest": "esbuild src/handlers/ingest.ts --bundle --platform=node --target=node20 --outfile=dist/ingest/ingest.js --external:pg-native",
    "build": "npm run build:app && npm run build:migrate && npm run build:scheduler && npm run build:ingest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0"
  }
}
